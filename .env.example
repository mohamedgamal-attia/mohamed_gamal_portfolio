# =============================================================================
# .env.example — variable NAMES only. Never put a real value in this file.
#
# These are configured as Supabase Edge Function secrets, not as files in the
# repository and never in anything the browser downloads:
#
#   supabase secrets set --env-file ./.env
#
# For local development the Gemini key is read from the process environment,
# so on Windows it is already available as GEMINI_API_KEY and does not need
# to be written down anywhere.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=

# ── Supplied automatically by Supabase in a deployed function ────────────────
# Set these only when running the function locally.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public key, needed by the resend function to verify an admin's session token.
SUPABASE_ANON_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Bot protection. Leave the secret blank to run without Turnstile; the
# honeypot and the server-side rate limit still apply.
TURNSTILE_SECRET_KEY=

# A long random string. It salts the hash used to count repeat callers, so the
# throttle table never has to store an IP address.
THROTTLE_SALT=

# Sender address. Must be a verified Resend domain in production.
NOTIFICATION_FROM_EMAIL=

# Public URLs, used in the notification email and for CORS.
PUBLIC_SITE_URL=
PUBLIC_ADMIN_URL=
ALLOWED_ORIGINS=

# Model and limits. Defaults are applied when these are unset.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=
RATE_LIMIT_PER_WINDOW=
RATE_LIMIT_WINDOW_SECONDS=
